{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "title": "Geometric",
  "slug": "geometric",
  "settings": {
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Inter\", \"Inter Fallback\", system-ui, -apple-system, sans-serif",
          "name": "Body",
          "slug": "body",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/inter-latin-wght.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"Outfit\", \"Outfit Fallback\", system-ui, -apple-system, sans-serif",
          "name": "Headings",
          "slug": "headings",
          "fontFace": [
            {
              "fontFamily": "Outfit",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/outfit-latin-wght.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "\"JetBrains Mono\", \"JetBrains Mono Fallback\", ui-monospace, monospace",
          "name": "Mono",
          "slug": "mono",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/jetbrains-mono-latin-400.woff2"
              ]
            }
          ]
        }
      ]
    }
  }
}
